<Project>

  <!--
    Import this file in any module .csproj to auto-generate TypeScript proxies on build.

    Usage in your .csproj:
      <Import Project="path/to/Vidra.CodeGen.targets" />

    Configurable properties (set before the Import):
      VidraTsOutputDir      - Required output directory for generated .ts files
      VidraSdkImport        - The import path for @vidra-dev/sdk (default: @vidra-dev/sdk)
      VidraCodeGenProject   - Path to the Vidra.CodeGen.csproj (auto-detected in monorepo)
      VidraGenerateTs       - Set to "false" to disable codegen (default: true)
      VidraContractScope    - "app" (default) or "core"

    Configurable items (set before the Import):
      VidraCodeGenAssembly  - Assemblies to scan. Defaults to this project's own
                              output. A project that aggregates contracts from
                              several assemblies — the framework's own dogfood
                              host is the only one today — lists them here
                              instead of hand-rolling its own Exec.
  -->

  <PropertyGroup>
    <VidraGenerateTs Condition="'$(VidraGenerateTs)' == ''">true</VidraGenerateTs>
    <VidraSdkImport Condition="'$(VidraSdkImport)' == ''">@vidra-dev/sdk</VidraSdkImport>
    <VidraContractScope Condition="'$(VidraContractScope)' == ''">app</VidraContractScope>
    <VidraCodeGenProject Condition="'$(VidraCodeGenProject)' == ''">$(MSBuildThisFileDirectory)/../../tools/Vidra.CodeGen/Vidra.CodeGen.csproj</VidraCodeGenProject>
    <VidraCodeGenDll Condition="'$(VidraCodeGenDll)' == ''">$(MSBuildThisFileDirectory)../tools/net10.0/any/Vidra.CodeGen.dll</VidraCodeGenDll>
    <VidraCodeGenCommand Condition="Exists('$(VidraCodeGenDll)')">dotnet exec &quot;$(VidraCodeGenDll)&quot;</VidraCodeGenCommand>
    <VidraCodeGenCommand Condition="'$(VidraCodeGenCommand)' == ''">dotnet run --configuration $(Configuration) --no-build --project &quot;$(VidraCodeGenProject)&quot; --</VidraCodeGenCommand>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="VidraContractScope" />
    <EmbeddedResource
      Include="$(MSBuildProjectDirectory)/Resources/Raw/vidra-bridge-policy.json"
      LogicalName="Vidra.Bridge.Policy"
      Visible="false"
      Condition="Exists('$(MSBuildProjectDirectory)/Resources/Raw/vidra-bridge-policy.json')" />
    <!-- Non-code policy changes require a rebuild and process restart: the
         running dispatcher owns an immutable snapshot of this resource. -->
    <Watch
      Include="$(MSBuildProjectDirectory)/Resources/Raw/vidra-bridge-policy.json"
      Condition="Exists('$(MSBuildProjectDirectory)/Resources/Raw/vidra-bridge-policy.json')" />
  </ItemGroup>

  <!--
    Both entry points below scan the same assemblies with the same arguments and
    differ only in the check flag, so the argument line is built once here. TargetPath
    is only known once the build is running, which is why the default lands in a
    target rather than a top-level ItemGroup.
  -->
  <Target Name="_VidraCodeGenArguments">
    <ItemGroup>
      <VidraCodeGenAssembly Condition="'@(VidraCodeGenAssembly)' == ''" Include="$(TargetPath)" />
      <!--
        Android (and other MAUI) builds do not copy package references next to
        the app assembly. Codegen still has to resolve Vidra.Bridge to read
        contract attributes, so hand it the directories the compiler referenced.
      -->
      <_VidraCodeGenProbe Include="@(ReferencePath->'%(RootDir)%(Directory)')" />
    </ItemGroup>
    <PropertyGroup>
      <_VidraCodeGenArgs>generate --assembly @(VidraCodeGenAssembly->'&quot;%(Identity)&quot;', ' ') @(_VidraCodeGenProbe->'--probe &quot;%(Identity)&quot;', ' ') --output &quot;$(VidraTsOutputDir)&quot; --sdk-import &quot;$(VidraSdkImport)&quot; --scope &quot;$(VidraContractScope)&quot;</_VidraCodeGenArgs>
    </PropertyGroup>
  </Target>

  <Target Name="_VidraCodeGenResolveReferences"
          DependsOnTargets="ResolveAssemblyReferences"
          Condition="'$(UsingMicrosoftNETSdk)' == 'true'" />

  <!--
    Runs when there is something to scan: an explicit assembly list, or this
    project's own output once it exists. A project whose Build produced no
    assembly (see MissingAggregateTarget.proj) is skipped rather than failed.

    The condition deliberately reads the item before _VidraCodeGenArguments
    fills in the default — MSBuild evaluates a target's Condition first and
    skips its DependsOnTargets entirely when that condition is false, so a
    condition can never read what its own dependency computes.
  -->
  <Target Name="VidraCodeGen"
          AfterTargets="Build"
          DependsOnTargets="_VidraCodeGenResolveReferences;_VidraCodeGenArguments"
          Condition="'$(VidraGenerateTs)' == 'true' AND '$(TargetFramework)' != '' AND '$(VidraTsOutputDir)' != '' AND ('@(VidraCodeGenAssembly)' != '' OR Exists('$(TargetPath)'))">

    <Message Importance="high" Text="[Vidra] Generating TypeScript proxies from @(VidraCodeGenAssembly->'%(Filename)', ', ')..." />

    <Exec Command="$(VidraCodeGenCommand) $(_VidraCodeGenArgs)"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          IgnoreExitCode="false" />

    <Message Importance="high" Text="[Vidra] TypeScript proxies written to $(VidraTsOutputDir)" />

  </Target>

  <Target Name="VidraCodeGenCheck"
          DependsOnTargets="_VidraCodeGenResolveReferences;_VidraCodeGenArguments"
          Condition="'$(VidraGenerateTs)' == 'true' AND '$(TargetFramework)' != '' AND '$(VidraTsOutputDir)' != '' AND ('@(VidraCodeGenAssembly)' != '' OR Exists('$(TargetPath)'))">
    <Exec Command="$(VidraCodeGenCommand) $(_VidraCodeGenArgs) --check"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          IgnoreExitCode="false" />
  </Target>

</Project>
