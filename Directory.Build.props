<Project>

  <!--
    Shared NuGet package metadata for all Vidra packages. Per-project csprojs
    still own PackageId and Description; the version is shared, and derived from
    version.json at the repo root by scripts/version.mjs — do not edit it here.
    Non-packable projects (the demo host app, the CodeGen tool) ignore these.
  -->
  <PropertyGroup>
    <VidraVersion>0.5.1</VidraVersion>
    <Version>$(VidraVersion)</Version>
    <Authors>rzamfiriu</Authors>
    <Company>Vidra</Company>
    <Product>Vidra</Product>
    <Copyright>Copyright © rzamfiriu</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://vidra.build</PackageProjectUrl>
    <RepositoryUrl>https://github.com/rzamfiriu/vidra.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>vidra;maui;webview;react;desktop;android;mobile;cross-platform</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

</Project>
